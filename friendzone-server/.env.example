# Database & Caching
DATABASE_URL=postgresql://user:password@localhost:5432/friendzone?schema=public
REDIS_URL=redis://localhost:6379

# Security & JWT Secrets
JWT_SECRET=replace_with_a_secure_jwt_secret_in_production
JWT_REFRESH_EXPIRATION_DAYS=30

# Resend Email Integration
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_REPLY_TO=friendzone_live@proton.me
FRONTEND_URL=http://localhost:5173

# Server Environment & Port
PORT=5000
NODE_ENV=development

# Cloudflare R2 Media Storage Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=friendzone
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=52428800
MAX_AUDIO_SIZE_BYTES=20971520
MAX_DOCUMENT_SIZE_BYTES=20971520

MEDIA_RETENTION_DAYS=7
MEDIA_PENDING_RETENTION_HOURS=24
MEDIA_SIGNED_URL_EXPIRATION_SECONDS=900

MEDIA_CLEANUP_CRON="0 3 * * *"
MEDIA_CLEANUP_TIMEZONE="Asia/Kolkata"
MEDIA_CLEANUP_BATCH_SIZE=100
