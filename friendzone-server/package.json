{
  "name": "friendzone-server",
  "version": "1.0.0",
  "description": "Production Backend Server for FriendZone Social Communication Application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "nodemon": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts"
  },
  "keywords": [
    "friendzone",
    "real-time",
    "translation",
    "websockets",
    "express",
    "typescript",
    "postgresql",
    "redis",
    "bullmq"
  ],
  "author": "FriendZone Architecture Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.1",
    "argon2": "^0.41.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "file-type": "^22.0.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "razorpay": "^2.9.8",
    "resend": "^6.19.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "stripe": "^22.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "@types/node-cron": "^3.0.11",
    "@types/sharp": "^0.31.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
