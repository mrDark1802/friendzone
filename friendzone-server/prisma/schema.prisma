generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  username                String                   @default("")
  passwordHash            String                   @map("password_hash")
  displayName             String                   @map("display_name")
  nativeLanguage          String                   @default("en") @map("native_language")
  translationEnabled      Boolean                  @default(true) @map("translation_enabled")
  role                    String                   @default("USER")
  isVerified              Boolean                  @default(false) @map("is_verified")
  lastSeen                DateTime?                @map("last_seen")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")
  plan                    String                   @default("FREE")
  dailyTranslationCount   Int                      @default(0) @map("daily_translation_count")
  monthlyTranslationCount Int                      @default(0) @map("monthly_translation_count")
  lastDailyReset          DateTime                 @default(now()) @map("last_daily_reset")
  lastMonthlyReset        DateTime                 @default(now()) @map("last_monthly_reset")
  countryCode             String?                  @map("country_code")
  dateOfBirth             DateTime?                @map("date_of_birth")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  onboardingCompleted     Boolean                  @default(false) @map("onboarding_completed")
  usagePurposes           String[]                 @default([]) @map("usage_purposes")
  razorpayCustomerId      String?                  @map("razorpay_customer_id")
  razorpaySubscriptionId  String?                  @map("razorpay_subscription_id")
  razorpayPlanId          String?                  @map("razorpay_plan_id")
  razorpayPaymentId       String?                  @map("razorpay_payment_id")
  currency                String?                  @default("inr")
  subscriptionStatus      String?                  @default("inactive") @map("subscription_status")
  currentPeriodStart      DateTime?                @map("current_period_start")
  currentPeriodEnd        DateTime?                @map("current_period_end")
  cancelAtPeriodEnd       Boolean                  @default(false) @map("cancel_at_period_end")
  blocksReceived          Block[]                  @relation("Blocked")
  blocksInitiated         Block[]                  @relation("Blocker")
  conversationMembers     ConversationMember[]
  createdConversations    Conversation[]           @relation("CreatedConversations")
  createdGroupInvites     GroupInvite[]
  emailVerificationTokens EmailVerificationToken[]
  friendshipsAction       Friendship[]             @relation("ActionUserFriendships")
  friendshipsAsUser1      Friendship[]             @relation("User1Friendships")
  friendshipsAsUser2      Friendship[]             @relation("User2Friendships")
  messages                Message[]
  passwordResetTokens     PasswordResetToken[]
  reportsReceived         Report[]                 @relation("ReportedUser")
  reportsSubmitted        Report[]                 @relation("Reporter")
  reviews                 Review[]                 @relation("UserReviews")
  fluentLanguages         UserFluentLanguage[]
  learningLanguages       UserLearningLanguage[]
  sessions                UserSession[]

  profileMediaId          String?                  @unique @map("profile_media_id")
  profileMedia            MediaAsset?              @relation("UserProfileMedia", fields: [profileMediaId], references: [id], onDelete: SetNull)
  mediaAssets             MediaAsset[]             @relation("UserOwnedMedia")

  @@index([deletedAt])
  @@map("users")
}

model UserFluentLanguage {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  languageCode String   @map("language_code")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode], name: "uk_user_fluent_lang")
  @@index([userId])
  @@map("user_fluent_languages")
}

model UserLearningLanguage {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  languageCode String   @map("language_code")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode], name: "uk_user_learning_lang")
  @@index([userId])
  @@map("user_learning_languages")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  familyId         String   @map("family_id")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  deviceInfo       String?  @map("device_info")
  ipAddress        String?  @map("ip_address")
  isRevoked        Boolean  @default(false) @map("is_revoked")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

model Friendship {
  id           String   @id @default(uuid())
  userId1      String   @map("user_id_1")
  userId2      String   @map("user_id_2")
  status       String   @default("PENDING")
  actionUserId String   @map("action_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  actionUser   User     @relation("ActionUserFriendships", fields: [actionUserId], references: [id], onDelete: Cascade)
  user1        User     @relation("User1Friendships", fields: [userId1], references: [id], onDelete: Cascade)
  user2        User     @relation("User2Friendships", fields: [userId2], references: [id], onDelete: Cascade)

  @@unique([userId1, userId2], name: "uk_friendship_pair")
  @@index([userId1, status])
  @@index([userId2, status])
  @@map("friendships")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId], name: "uk_blocker_blocked")
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

model Conversation {
  id                      String               @id @default(uuid())
  type                    String               @default("DIRECT")
  title                   String?
  description             String?
  avatarUrl               String?              @map("avatar_url")
  canonicalPair           String?              @unique @map("canonical_pair")
  createdBy               String               @map("created_by")
  onlyAdminsCanSend       Boolean              @default(false) @map("only_admins_can_send")
  onlyAdminsCanEditInfo   Boolean              @default(false) @map("only_admins_can_edit_info")
  onlyAdminsCanAddMembers Boolean              @default(false) @map("only_admins_can_add_members")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  deletedAt               DateTime?            @map("deleted_at")
  members                 ConversationMember[]
  creator                 User                 @relation("CreatedConversations", fields: [createdBy], references: [id])
  messages                Message[]
  invites                 GroupInvite[]
  mediaAssets             MediaAsset[]

  @@index([type])
  @@map("conversations")
}

model ConversationMember {
  id                String       @id @default(uuid())
  conversationId    String       @map("conversation_id")
  userId            String       @map("user_id")
  role              String       @default("MEMBER")
  status            String       @default("ACTIVE")
  preferredLanguage String?      @map("preferred_language")
  lastReadMessageId String?      @map("last_read_message_id")
  joinedAt          DateTime     @default(now()) @map("joined_at")
  leftAt            DateTime?    @map("left_at")
  addedBy           String?      @map("added_by")
  removedBy         String?      @map("removed_by")
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lastReadMessage   Message?     @relation("LastReadMessage", fields: [lastReadMessageId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId], name: "uk_conv_user")
  @@index([userId])
  @@index([conversationId, status])
  @@map("conversation_members")
}

model Message {
  id                  String               @id @default(uuid())
  conversationId      String               @map("conversation_id")
  senderId            String               @map("sender_id")
  contentOriginal     String               @map("content_original")
  originalLanguage    String               @map("original_language")
  idempotencyKey      String               @map("idempotency_key")
  messageType         String               @default("USER") @map("message_type")
  systemMetadata      Json?                @map("system_metadata")
  createdAt           DateTime             @default(now()) @map("created_at")
  deletedAt           DateTime?            @map("deleted_at")
  status              String               @default("SENT")
  conversationMembers ConversationMember[] @relation("LastReadMessage")
  translations        MessageTranslation[]
  conversation        Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender              User                 @relation(fields: [senderId], references: [id])
  reports             Report[]
  mediaAssets         MediaAsset[]

  @@unique([conversationId, idempotencyKey], name: "uk_messages_idempotency")
  @@index([conversationId, createdAt, id])
  @@map("messages")
}

model GroupInvite {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  tokenHash      String       @unique @map("token_hash")
  createdBy      String       @map("created_by")
  expiresAt      DateTime?    @map("expires_at")
  maxUses        Int?         @map("max_uses")
  useCount       Int          @default(0) @map("use_count")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  creator        User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([conversationId])
  @@map("group_invites")
}

model MessageTranslation {
  id                String   @id @default(uuid())
  messageId         String   @map("message_id")
  targetLanguage    String   @map("target_language")
  translatedContent String?
  provider          String   @default("deepl")
  status            String   @default("PENDING")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  message           Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, targetLanguage], name: "uk_message_target_lang")
  @@index([messageId, targetLanguage])
  @@map("message_translations")
}

model TranslationCache {
  id                String   @id @default(uuid())
  provider          String   @default("deepl")
  sourceLanguage    String   @map("source_language")
  targetLanguage    String   @map("target_language")
  textHash          String   @map("text_hash")
  translatedContent String   @map("translated_content")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([provider, sourceLanguage, targetLanguage, textHash], name: "uk_provider_src_tgt_hash")
  @@index([sourceLanguage, targetLanguage, textHash])
  @@map("translation_cache")
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String   @map("reporter_id")
  reportedUserId String   @map("reported_user_id")
  messageId      String?  @map("message_id")
  reason         String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now()) @map("created_at")
  message        Message? @relation(fields: [messageId], references: [id])
  reportedUser   User     @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model MediaAsset {
  id               String       @id @default(uuid())

  ownerId          String       @map("owner_id")
  conversationId   String?      @map("conversation_id")
  messageId        String?      @map("message_id")

  mediaCategory    String       @map("media_category")
  mediaType        String       @map("media_type")
  mimeType         String       @map("mime_type")

  originalName     String       @map("original_name")
  storageKey       String       @map("storage_key")
  thumbnailKey     String?      @map("thumbnail_key")

  size             Int
  width            Int?
  height           Int?
  duration         Float?

  uploadStatus     String       @default("PENDING") @map("upload_status")
  moderationStatus String       @default("PENDING") @map("moderation_status")

  expiresAt        DateTime?    @map("expires_at")

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  owner            User          @relation("UserOwnedMedia", fields: [ownerId], references: [id], onDelete: Cascade)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message          Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  profileUsers     User[]        @relation("UserProfileMedia")

  @@index([ownerId])
  @@index([conversationId])
  @@index([messageId])
  @@index([uploadStatus])
  @@index([moderationStatus])
  @@index([expiresAt, deletedAt])
  @@map("media_assets")
}

model RazorpayWebhookEvent {
  id              String   @id @default(uuid())
  razorpayEventId String   @unique @map("razorpay_event_id")
  eventType       String   @map("event_type")
  processed       Boolean  @default(true)
  processedAt     DateTime @default(now()) @map("processed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("razorpay_webhook_events")
}

